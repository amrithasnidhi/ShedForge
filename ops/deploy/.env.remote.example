# Core deployment wiring
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# Backend mandatory
DATABASE_URL=postgresql+psycopg://postgres:postgres@db-host:5432/shedforge
JWT_SECRET_KEY=replace-with-strong-secret

# Backend auth defaults
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_OTP_EXPIRE_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5

# CORS and security
CORS_ORIGINS=["https://app.example.com"]
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# SMTP (optional but recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-with-provider-key
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=ShedForge
SMTP_USE_TLS=true
SMTP_USE_SSL=false
